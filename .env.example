# App Configuration
NEXT_PUBLIC_APP_URL=https://taxreadywallet.com
NEXT_PUBLIC_SITE_NAME=TaxReadyWallet
NODE_ENV=development

# NextAuth Configuration
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (Neon Serverless Postgres)
# Get connection string from https://console.neon.tech
NEON_DATABASE_URL=psql'postgresql://neondb_owner:npg_MAuCBvxNK08e@ep-calm-mouse-addn2vx2-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Legacy (kept for reference)
DATABASE_URL=postgresql://user:password@localhost:5432/taxreadywallet

# Error Tracking - Sentry
