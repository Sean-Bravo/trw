# =============================================================================
# TaxFormatter Environment Configuration
# Copy this file to .env.local and fill in your values
# =============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TaxFormatter
NODE_ENV=development

# NextAuth Configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (Neon Serverless Postgres)
# Get from https://console.neon.tech
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Email (Resend)
# Get from https://resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# Mailchimp - Newsletter & Waitlist
# Get from https://mailchimp.com
MAILCHIMP_API_KEY=your-api-key-us1
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=your-audience-id

# Google Gemini AI (Free tier insights)
# Get from https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=your-purchase-conversion-label

# Stripe (optional - for payments)
# Get from https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_ANNUAL=price_xxx
# STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
# STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx

# AWS (optional - for file storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Feature Flags
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true
NEXT_PUBLIC_MAX_FILE_SIZE=10485760

# MVP Mode - Set to 'false' to enable paid tier restrictions
# When true (default), all users get access to all features regardless of tier
NEXT_PUBLIC_MVP_MODE=true
