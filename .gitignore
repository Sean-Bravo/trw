# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# contentlayer (generated cache)
.contentlayer/

# production
/build

# misc
.DS_Store
*.pem
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Terraform
terraform.tfvars
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Backend build artifacts
backend/.build/
backend/**/__pycache__/
backend/**/*.pyc
*.zip

# Debug scripts
backend/debug_*.py

# Sentry Config File
.env.sentry-build-plugin

# Package build artifacts
packages/*/dist/
packages/*/node_modules/
packages/*/package-lock.json
__pycache__/
