// TaxFormatter Database Schema
// Production-grade schema with all hardening from the specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Core application tables
model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  emailVerified      DateTime?      @map("email_verified")
  name               String?
  image              String?
  hashedPassword     String?        @map("hashed_password")
  subscriptionTier   String         @default("free") @map("subscription_tier")
  stripeCustomerId   String?        @unique @map("stripe_customer_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  accounts           Account[]
  sessions           Session[]
  subscription       Subscription?
  uploads            Upload[]
  jobs               Job[]
  jobEvents          JobEvent[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  tier                 String    // 'free', 'pro', 'premium'
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  status               String    @default("active") // 'active', 'expired', 'cancelled'
  renewalDate          DateTime? @map("renewal_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tier])
  @@map("subscriptions")
}

model Upload {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  filename   String
  s3Key      String    @map("s3_key")
  fileSize   BigInt    @map("file_size")
  fileSha256 String?   @map("file_sha256") @db.VarChar(64)
  status     String    @default("pending") // 'pending', 'processing', 'completed', 'failed'
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("uploads")
}

model Job {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  uploadId              String    @unique @map("upload_id")
  s3Path                String    @map("s3_path")
  status                String    @default("queued") // 'queued', 'processing', 'completed', 'failed', 'cancelled'
  progressStage         String?   @map("progress_stage")
  exchangeDetected      String?   @map("exchange_detected")
  transactionCount      Int?      @map("transaction_count")
  parsedSummary         Json?     @map("parsed_summary")
  taxFlags              Json?     @map("tax_flags")
  aiSummary             String?   @map("ai_summary") @db.Text
  aiConfidence          Float?    @map("ai_confidence")
  aiModelName           String?   @map("ai_model_name")
  aiModelVersion        String?   @map("ai_model_version")
  aiPromptHash          String?   @map("ai_prompt_hash") @db.VarChar(64)
  formattedS3Key        String?   @map("formatted_s3_key")
  flaggedS3Key          String?   @map("flagged_s3_key")
  errorMessage          String?   @map("error_message") @db.Text
  processingStartedAt   DateTime? @map("processing_started_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  deletedAt             DateTime? @map("deleted_at")
  retryCount            Int       @default(0) @map("retry_count")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload    Upload     @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  jobEvents JobEvent[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("jobs")
}

model JobEvent {
  id        BigInt   @id @default(autoincrement())
  jobId     String   @map("job_id")
  userId    String   @map("user_id")
  eventType String   @map("event_type") // 'created', 'processing', 'completed', 'failed', 'downloaded', 'cancelled'
  eventData Json?    @map("event_data")
  createdAt DateTime @default(now()) @map("created_at")

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("job_events")
}

model IdempotencyKey {
  keyHash    String    @id @map("key_hash") @db.VarChar(64)
  userId     String    @map("user_id")
  resultJson String?   @map("result_json") @db.Text
  expiresAt  DateTime  @map("expires_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
